{
  "short_name": "Feelz Machine",
  "name": "Feelz Machine — Independent Music",
  "description": "Stream and support independent artists. Afrobeats, Amapiano, Hip Hop, R&B and more. Direct from artist to fan.",
  "lang": "en",
  "dir": "ltr",
  "categories": ["music", "entertainment"],
  "icons": [
    { "src": "/icon-192.png",      "sizes": "192x192", "type": "image/png", "purpose": "any"      },
    { "src": "/icon-512.png",      "sizes": "512x512", "type": "image/png", "purpose": "any"      },
    { "src": "/icon-maskable.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" }
  ],
  "start_url": "/?source=pwa",
  "scope": "/",
  "id": "feelzmachine-pwa",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "orientation": "portrait-primary",
  "theme_color": "#000000",
  "background_color": "#000000",
  "launch_handler": { "client_mode": "navigate-existing" },
  "edge_side_panel": { "preferred_width": 480 },
  "handle_links": "preferred",
  "screenshots": [
    { "src": "/screenshots/screen-home.png",   "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Home feed"      },
    { "src": "/screenshots/screen-browse.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Browse music"   },
    { "src": "/screenshots/screen-artist.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Artist profile" },
    { "src": "/screenshots/screen-player.png", "sizes": "1080x1920", "type": "image/png", "form_factor": "narrow", "label": "Now playing"   }
  ],
  "shortcuts": [
    { "name": "Browse music",    "short_name": "Browse",    "description": "Discover new tracks and artists",        "url": "/browse",    "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Community feed",  "short_name": "Feed",      "description": "Posts from artists you follow",          "url": "/feed",      "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "My library",      "short_name": "Library",   "description": "Your liked songs and playlists",         "url": "/library",   "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Notifications",   "short_name": "Alerts",    "description": "Your latest activity",                   "url": "/notifications", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ],
  "prefer_related_applications": false
}